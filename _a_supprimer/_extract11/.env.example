STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Emails (V1.5) — Resend / Postmark
EMAIL_API_KEY=""

# Paiement (V2) — Stripe
STRIPE_SECRET_KEY=""
