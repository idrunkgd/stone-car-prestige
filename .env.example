# ─────────────────────────────────────────────────────────────
# Stone Car Prestige — variables d'environnement
# ─────────────────────────────────────────────────────────────

# Connexion PostgreSQL (fournie par Coolify quand tu lies la base à l'app).
# Exemple : postgres://postgres:MOT_DE_PASSE@nom-du-service-db:5432/postgres
DATABASE_URL=

# Optionnel : mettre "require" UNIQUEMENT si la base exige le SSL
# (base managée externe type Neon/Supabase). Inutile pour le Postgres
# interne de Coolify.
# DATABASE_SSL=require

# ─────────────────────────────────────────────────────────────
# Espace pro
# ─────────────────────────────────────────────────────────────

# Administrateur (droits complets). Défauts : stone@stone.be / Azerty12.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Compte employé (facultatif). Accès limité : planning, check-in, clients,
# abonnements — peut valider un lavage mais ne peut ni créer de formule,
# ni corriger une carte, ni annuler un tampon.
# Tant que STAFF_PASSWORD n'est pas défini, ce compte n'existe pas.
# STAFF_EMAIL=
# STAFF_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Abonnements
# ─────────────────────────────────────────────────────────────

# URL publique du site : sert à construire le contenu des QR codes des
# cartes. À défaut, elle est déduite des en-têtes de la requête.
# NEXT_PUBLIC_SITE_URL=https://stonecarprestige.be

# Envoi des emails de notification (facultatif). Sans ces deux variables,
# les notifications restent visibles dans l'espace client mais aucun email
# n'est envoyé.
# RESEND_API_KEY=
# MAIL_FROM=Stone Car Prestige <no-reply@stonecarprestige.be>

# Relances automatiques (expiration proche, solde faible). Appeler une fois
# par jour :
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#        https://stonecarprestige.be/api/abonnements/relances
# CRON_SECRET=
