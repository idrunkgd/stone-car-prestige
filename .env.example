# ─────────────────────────────────────────────────────────────
# Stone Car Prestige — variables d'environnement
# ─────────────────────────────────────────────────────────────

# Connexion PostgreSQL (fournie par Coolify quand tu lies la base à l'app).
# Exemple : postgres://postgres:MOT_DE_PASSE@nom-du-service-db:5432/postgres
DATABASE_URL=

# Optionnel : mettre "require" UNIQUEMENT si la base exige le SSL
# (base managée externe type Neon/Supabase). Inutile pour le Postgres
# interne de Coolify.
# DATABASE_SSL=require
