// Stone Car Prestige — modèle de données
// PostgreSQL + Prisma. Soft delete (deletedAt) sur les données commerciales.
// Multi-site prévu via siteId optionnel (inactif au lancement).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────  ACCÈS & UTILISATEURS  ─────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYE
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      UserRole  @default(EMPLOYE)
  passwordHash String?
  active    Boolean   @default(true)
  auditLogs AuditLog[]
  workOrders WorkOrder[] @relation("Technician")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String   // ex: "invoice.update", "price.change"
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
}

// ─────────────────────────────  CLIENTS  ─────────────────────────────

enum CustomerTag {
  NOUVEAU
  REGULIER
  VIP
  INACTIF
}

model Customer {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  company       String?
  phone         String?
  email         String?
  vatNumber     String?
  language      String    @default("fr")
  notes         String?
  source        String?
  marketingConsent Boolean @default(false)
  tag           CustomerTag @default(NOUVEAU)
  addresses     CustomerAddress[]
  vehicles      Vehicle[]
  bookings      Booking[]
  workOrders    WorkOrder[]
  quotes        Quote[]
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  line1      String
  line2      String?
  postalCode String?
  city       String?
  country    String   @default("BE")
  isPrimary  Boolean  @default(true)
}

// ─────────────────────────────  VÉHICULES  ─────────────────────────────

model VehicleCategory {
  id       String    @id @default(cuid())
  key      String    @unique // citadine, berline, suv, grand-suv, sportive, ...
  label    String
  order    Int       @default(0)
  vehicles Vehicle[]
  prices   ServicePrice[]
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
  AUTRE
}

model Vehicle {
  id          String    @id @default(cuid())
  make        String
  model       String
  version     String?
  year        Int?
  plate       String
  vin         String?
  color       String?
  mileage     Int?
  fuel        FuelType?
  bodyType    String?
  category    VehicleCategory? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  owner       Customer? @relation(fields: [ownerId], references: [id])
  ownerId     String?
  bookings    Booking[]
  workOrders  WorkOrder[]
  photos      Photo[]
  inspections Inspection[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([plate])
}

// ─────────────────────────────  CATALOGUE  ─────────────────────────────

model ServiceCategory {
  id       String    @id @default(cuid())
  label    String
  order    Int       @default(0)
  services Service[]
}

enum PriceMode {
  FIXE          // prix unique
  PAR_TAILLE    // selon catégorie véhicule
  A_PARTIR_DE   // detailing / reconditionnement
  SUR_DEVIS
}

model Service {
  id            String   @id @default(cuid())
  name          String
  shortDesc     String?
  commercialDesc String?
  photoUrl      String?
  durationMin   Int      @default(60)
  priceMode     PriceMode @default(FIXE)
  basePrice     Decimal? @db.Decimal(10, 2)
  vatRate       Decimal  @default(21) @db.Decimal(5, 2)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  categoryId    String?
  bookableOnline Boolean @default(true)
  depositRequired Boolean @default(false)
  depositMode   String?  // aucun | fixe | pourcentage
  depositValue  Decimal? @db.Decimal(10, 2)
  order         Int      @default(0)
  active        Boolean  @default(true)
  prices        ServicePrice[]
  options       ServiceOption[]
  checklist     ChecklistItem[]
  packageItems  PackageItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model ServicePrice {
  id         String   @id @default(cuid())
  service    Service  @relation(fields: [serviceId], references: [id])
  serviceId  String
  category   VehicleCategory @relation(fields: [categoryId], references: [id])
  categoryId String
  price      Decimal  @db.Decimal(10, 2)

  @@unique([serviceId, categoryId])
}

model ServiceOption {
  id        String  @id @default(cuid())
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String
  label     String  // ex: "Nettoyage des sièges"
  price     Decimal @db.Decimal(10, 2)
  isUpsell  Boolean @default(true)
}

model Package {
  id        String        @id @default(cuid())
  name      String        // Essential / Premium / Signature
  desc      String?
  price     Decimal       @db.Decimal(10, 2)
  active    Boolean       @default(true)
  items     PackageItem[]
  createdAt DateTime      @default(now())
  deletedAt DateTime?
}

model PackageItem {
  id        String  @id @default(cuid())
  package   Package @relation(fields: [packageId], references: [id])
  packageId String
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String
}

model ChecklistItem {
  id        String  @id @default(cuid())
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?
  label     String  // ex: prélavage, jantes, séchage...
  order     Int     @default(0)
  kind      String  @default("intervention") // intervention | qualite
}

// ─────────────────────────────  RENDEZ-VOUS  ─────────────────────────────

enum BookingStatus {
  PREVU
  CONFIRME
  CLIENT_ARRIVE
  ANNULE
  ABSENT
  TRANSFORME // devenu WorkOrder
}

model Booking {
  id         String   @id @default(cuid())
  reference  String   @unique // RES-2026-0045
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId  String
  startAt    DateTime
  durationMin Int     @default(60)
  status     BookingStatus @default(PREVU)
  serviceIds String[] // simplifié ; peut devenir table n-n
  optionIds  String[]
  notes      String?
  atHome     Boolean  @default(false)
  workOrder  WorkOrder?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
}

// ─────────────────────────────  OPÉRATIONS  ─────────────────────────────

enum WorkOrderStatus {
  RECU
  EN_COURS
  EN_PAUSE
  EN_ATTENTE
  TERMINE
  CONTROLE_QUALITE
  PRET
  LIVRE
}

model WorkOrder {
  id           String   @id @default(cuid())
  reference    String   @unique // WO-2026-000124
  booking      Booking? @relation(fields: [bookingId], references: [id])
  bookingId    String?  @unique
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId    String
  technician   User?    @relation("Technician", fields: [technicianId], references: [id])
  technicianId String?
  status       WorkOrderStatus @default(RECU)
  plannedStart DateTime?
  plannedEnd   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  workedMinutes Int?
  priceEstimate Decimal? @db.Decimal(10, 2)
  mileage      Int?
  items        WorkOrderItem[]
  inspection   Inspection?
  photos       Photo[]
  signatures   Signature[]
  quote        Quote?
  invoice      Invoice?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

model WorkOrderItem {
  id          String   @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String
  label       String
  price       Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @default(21) @db.Decimal(5, 2)
  kind        String   @default("service") // service | option | supplement
  needsApproval Boolean @default(false)
  approved    Boolean  @default(true)
  done        Boolean  @default(false)
}

// ─────────────────────────────  ÉTAT DES LIEUX & PHOTOS  ─────────────────────────────

model Inspection {
  id          String   @id @default(cuid())
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?  @unique
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId   String
  mileage     Int?
  notes       String?
  damages     InspectionDamage[]
  createdAt   DateTime @default(now())
}

model InspectionDamage {
  id           String   @id @default(cuid())
  inspection   Inspection @relation(fields: [inspectionId], references: [id])
  inspectionId String
  zone         String   // avant-gauche, portière-droite, jante-AV-D...
  type         String   // rayure, bosse, impact, jante, pare-brise...
  note         String?
  photoUrl     String?
}

enum PhotoType {
  CHECKIN
  DOMMAGE
  AVANT
  PENDANT
  APRES
  CHECKOUT
  AUTRE
}

model Photo {
  id          String    @id @default(cuid())
  url         String
  type        PhotoType @default(AUTRE)
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  vehicleId   String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?
  createdAt   DateTime  @default(now())
}

model Signature {
  id          String    @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String
  signerName  String
  purpose     String    // etat-vehicule | accord-prestation | supplement | reception | restitution
  dataUrl     String    // image de la signature
  ip          String?
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────  VENTES  ─────────────────────────────

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  TRANSFORME
}

model Quote {
  id          String   @id @default(cuid())
  reference   String   @unique // DEV-2026-0012
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?  @unique
  status      QuoteStatus @default(BROUILLON)
  items       QuoteItem[]
  discount    Decimal? @db.Decimal(10, 2)
  notes       String?
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model QuoteItem {
  id       String  @id @default(cuid())
  quote    Quote   @relation(fields: [quoteId], references: [id])
  quoteId  String
  label    String
  price    Decimal @db.Decimal(10, 2)
  qty      Int     @default(1)
  vatRate  Decimal @default(21) @db.Decimal(5, 2)
}

enum InvoiceStatus {
  BROUILLON
  ENVOYEE
  PAYEE
  PARTIELLE
  IMPAYEE
  ANNULEE
}

model Invoice {
  id          String   @id @default(cuid())
  reference   String   @unique // FAC-2026-0012
  customer    Customer @relation(fields: [customerId], references: [id])
  customerId  String
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?  @unique
  status      InvoiceStatus @default(BROUILLON)
  items       InvoiceItem[]
  payments    Payment[]
  totalHt     Decimal  @default(0) @db.Decimal(10, 2)
  totalVat    Decimal  @default(0) @db.Decimal(10, 2)
  totalTtc    Decimal  @default(0) @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String
  label     String
  price     Decimal @db.Decimal(10, 2)
  qty       Int     @default(1)
  vatRate   Decimal @default(21) @db.Decimal(5, 2)
}

enum PaymentMethod {
  ESPECES
  CARTE
  VIREMENT
  EN_LIGNE
  AUTRE
}

model Payment {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId String
  amount    Decimal  @db.Decimal(10, 2)
  method    PaymentMethod
  isDeposit Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Discount {
  id        String   @id @default(cuid())
  label     String
  amount    Decimal? @db.Decimal(10, 2)
  percent   Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now())
}

model PromoCode {
  id         String   @id @default(cuid())
  code       String   @unique
  amount     Decimal? @db.Decimal(10, 2)
  percent    Decimal? @db.Decimal(5, 2)
  validUntil DateTime?
  maxUses    Int?
  usedCount  Int      @default(0)
  oncePerCustomer Boolean @default(false)
  active     Boolean  @default(true)
}

model GiftCard {
  id         String   @id @default(cuid())
  code       String   @unique
  amount     Decimal  @db.Decimal(10, 2)
  balance    Decimal  @db.Decimal(10, 2)
  expiresAt  DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────  RESSOURCES & SYSTÈME  ─────────────────────────────

model Resource {
  id       String  @id @default(cuid())
  name     String  // Box 1, Zone lavage, Pont, ...
  kind     String  @default("box")
  active   Boolean @default(true)
}

enum NotificationKind {
  RESERVATION
  ANNULATION
  CLIENT_ARRIVE
  PRESTATION_TERMINEE
  PAIEMENT_ATTENDU
  DEVIS_EN_ATTENTE
  RETARD
  A_RECUPERER
}

model Notification {
  id        String   @id @default(cuid())
  kind      NotificationKind
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BusinessSettings {
  id            String   @id @default("default")
  name          String   @default("Stone Car Prestige")
  logoUrl       String?
  companyNumber String?
  vatNumber     String?
  address       String?
  phone         String?
  email         String?
  iban          String?
  website       String?
  openingHours  Json?
  invoicePrefix String   @default("FAC")
  quotePrefix   String   @default("DEV")
  bookingPrefix String   @default("RES")
  workOrderPrefix String @default("WO")
  updatedAt     DateTime @updatedAt
}
